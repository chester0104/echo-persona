# Keys for the Python pipeline. Copy to .env and fill in.

OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Only needed for stage 6, the Together AI fine tune. Leave empty otherwise.
TOGETHER_API_KEY=""

# Optional. Which persona to use when more than one exists and --persona is not given.
# ECHO_PERSONA="sam"

# Optional. Only if ffmpeg is installed somewhere the code cannot find on its own.
# FFMPEG_BINARY="C:/path/to/ffmpeg.exe"
# FFPROBE_BINARY="C:/path/to/ffprobe.exe"
