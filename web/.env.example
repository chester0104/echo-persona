# Copy to .env.local and fill in. Never commit real values.

# server side only, never reaches the browser
OPENAI_API_KEY=""

# any OpenAI compatible endpoint
OPENAI_BASE_URL="https://api.openai.com/v1"

# model name for the chat calls
OPENAI_MODEL="gpt-5.6-terra"

# omit and the site falls back to browser speech
ELEVENLABS_API_KEY=""

# style cards, public and private tiers
ECHO_PERSONAS_B64=""

# global messages per day
ECHO_DAILY_MESSAGE_CAP="80"

# messages per minute per visitor
ECHO_IP_BURST="6"

# shared library voices added per day
ECHO_SHARED_VOICE_CAP="25"

# unlocks the admin panel
ECHO_ADMIN_TOKEN=""

# who may unlock private mode
ECHO_TOTP_GRANTS=""
